{
  "name": "till-recorder",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "account_id": "2aba2de5418ac0812383b628b6cb0f77",
  "workers_dev": true,
  "assets": {
    "directory": "../viewer",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "till-recorder"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_RELAY", "class_name": "LiveRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1-live-relay", "new_sqlite_classes": ["LiveRelay"] }
  ],
  "triggers": {
    "crons": ["0 8 * * *"]
  }
}
